tawtheeq-ksa.com {
	encode zstd gzip

	reverse_proxy school-reports-web:8000 {
		header_up X-Real-IP {remote_host}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format json
	}
}

www.tawtheeq-ksa.com, app.tawtheeq-ksa.com {
	redir https://tawtheeq-ksa.com{uri} permanent
}
