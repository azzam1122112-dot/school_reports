[Unit]
Description=Offsite media backup for School Reports
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/school-reports-backup.conf
ExecStart=/usr/local/sbin/school-reports-media-backup
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
