#: .\reports\templates\reports\landing.html:466
#: .\reports\templates\reports\landing.html:475
#: .\reports\templates\reports\landing.html:484
#: .\reports\templates\reports\landing.html:493
#: .\reports\templates\reports\landing.html:502
#: .\reports\templates\reports\landing.html:511
msgid "مع منصة توثيق"
msgstr "With Tawtheeq"

#: .\reports\templates\reports\landing.html:466
msgid "مسار عمل واحد موثّق"
