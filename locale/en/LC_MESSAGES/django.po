msgid "الاستمرارية"
msgstr "Continuity"

#: .\reports\templates\reports\landing.html:551
msgid "ذاكرة لا تتبعثر بتغير الفريق"
msgstr "A memory that survives staff changes"

#: .\reports\templates\reports\landing.html:552
msgid "تقارير وقرارات وشواهد تبقى منظمة وقابلة للرجوع."
