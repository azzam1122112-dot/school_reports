msgstr "Agenda, attendance and decisions in one place, producing minutes that are properly recorded rather than hastily typed."

#: .\reports\templates\reports\landing.html:647
msgid "جدول أعمال وحضور"
msgstr "Agenda and attendance"

#: .\reports\templates\reports\landing.html:648
msgid "قرارات وتوصيات"
