msgstr "Price calculated instantly"

#: .\reports\templates\reports\landing.html:899
msgid "عدد فريقك"
msgstr "Your team size"

#: .\reports\templates\reports\landing.html:900
msgid "مقاعد للنمو"
msgstr "Seats for growth"

#: .\reports\templates\reports\landing.html:901
msgid "مساحة التخزين"
msgstr "Storage"

#: .\reports\templates\reports\landing.html:903
msgid "نختار لك السعة الأقل تكلفة تلقائياً."
msgstr "We automatically select the lowest-cost capacity for you."

#: .\reports\templates\reports\landing.html:913
