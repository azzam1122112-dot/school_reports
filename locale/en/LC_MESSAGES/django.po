#: .\reports\templates\reports\landing.html:335
msgid "قارن مدارس مجموعتك واتخذ قرارك من مستوى واحد"
msgstr "Compare your group’s schools and decide from one level"

#: .\reports\templates\reports\landing.html:336
msgid ""
