#: .\reports\templates\reports\landing.html:556
#: .\reports\templates\reports\landing.html:721
msgid "لمن يدير أكثر من مدرسة"
msgstr "For those running more than one school"

#: .\reports\templates\reports\landing.html:556
msgid "حساب إداري واحد للتنقّل، مع بيانات وباقة ودفع مستقل لكل مدرسة."
msgstr "One administrative account to move between schools, with separate data, plan and billing for each."

#: .\reports\templates\reports\landing.html:566
