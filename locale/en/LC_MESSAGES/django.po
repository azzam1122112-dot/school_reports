#: .\reports\templates\reports\landing.html:658
msgid "لوحة مهام للإدارة"
msgstr "A task board for management"

#: .\reports\templates\reports\landing.html:659
msgid "«المسندة إليّ» للمنسوبين"
msgstr "“Assigned to me” for staff"

#: .\reports\templates\reports\landing.html:660
msgid "تنبيه عند التأخر"
