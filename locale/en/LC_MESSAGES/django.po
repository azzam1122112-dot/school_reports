#: .\reports\templates\reports\landing.html:327
msgid "محاور وشواهد ومراجعة واعتماد"
msgstr "Sections, evidence, review and approval"

#: .\reports\templates\reports\landing.html:328
msgid "كل ما يخصك أمامك"
msgstr "Everything that concerns you, in front of you"

#: .\reports\templates\reports\landing.html:328
msgid "تكليفات وطلبات واجتماعات وتعاميم"
msgstr "Assignments, requests, meetings and circulars"

#: .\reports\templates\reports\landing.html:334
